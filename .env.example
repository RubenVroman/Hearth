# Hearth — copy to .env on VAULT. Never commit the real file.
# Bind to LAN / Tailscale only. Do not port-forward these ports on the router.

# --- Runtime ---
# Host IP to publish ports on. Leave 0.0.0.0 for LAN+Tailscale; set to your
# Tailscale IP (100.x.y.z) to keep it off the rest of the LAN.
HEARTH_BIND=0.0.0.0
HEARTH_PORT=8787
HEARTH_HOUSE_NAME=VAULT
HEARTH_OWNER=Ruben
# Optional shared secret for machine/agent callers (header X-Hearth-Token only).
# Browser users must log in. If unset, only login counts. Do not put this in a URL.
# HEARTH_TOKEN=

# --- Login (house pattern: FastAPI + bcrypt + X-Auth-Token + HttpOnly refresh cookie) ---
# Required to issue JWTs. Generate a long random string. Never commit the real value.
# APP_SECRET_KEY=
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=14
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# First superuser is created on boot only if the users table is empty.
# HEARTH_ADMIN_EMAIL=
# HEARTH_ADMIN_PASSWORD=
# SQLite file (persistent volume). No Postgres required.
# HEARTH_AUTH_DB=/app/data/hearth-auth.db

# Path inside the container. Compose bind-mounts ./workspace here.
WORKSPACE_PATH=/app/workspace

# When HA / Plex / Docker are unconfigured, return house-shaped fixtures
# so the command center and agent loop still run.
HEARTH_MOCK_IF_UNCONFIGURED=true

# --- OpenAI (text agent + Realtime voice) ---
# Leave empty to run in fallback: local intent router + mocked tools.
# Live voice is GA WebRTC (ChatGPT-app path), not the disabled beta websocket.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=marin
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Home Assistant (device layer: lights, Denon AVR-X3700H, LG webOS TV) ---
# From the hearth container, the compose service is reachable as:
HA_URL=http://homeassistant:8123
# Long-lived access token from HA Profile → Security. Empty = mocked entities.
HA_TOKEN=
# Entity IDs after pairing (HA names them per device). Defaults match fixtures.
# If live entities differ, set these so ha_media_control / house_media resolve correctly.
HA_TV_ENTITY=media_player.lg_webos_tv
HA_AVR_ENTITY=media_player.denon_avr_x3700h

# --- Plex (existing stack on the NAS, not this compose file) ---
# host.docker.internal is the Synology host from the container.
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=
# Optional default client when “play X on the TV” is ambiguous (substring match).
# Examples: Apple TV, LG, Living Room
# PLEX_DEFAULT_PLAYER=

# --- *arr / Overseerr (existing stack on the NAS — grab/request, not Plex playback) ---
RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=
SONARR_URL=http://host.docker.internal:8989
SONARR_API_KEY=
OVERSEERR_URL=http://host.docker.internal:5055
OVERSEERR_API_KEY=

# --- Chief of Staff (repo/PR, Gridways, Discord, calendar, anything Hearth cannot do) ---
# POST JSON to this URL. Auth header if key is set: Authorization: Bearer <HEARTH_COS_WEBHOOK_KEY>
# Leave empty — Hearth will say it is not configured. Do not invent a URL.
HEARTH_COS_WEBHOOK=
HEARTH_COS_WEBHOOK_KEY=
# HEARTH_COS_REPO=RubenVroman/Hearth

# --- Docker inspect (read-only socket is mounted by compose) ---
DOCKER_SOCKET=/var/run/docker.sock
