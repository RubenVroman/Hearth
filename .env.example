# Hearth — copy to .env on VAULT. Never commit the real file.
# Bind to LAN / Tailscale only. Do not port-forward these ports on the router.

# --- Runtime ---
# Host IP to publish ports on. Leave 0.0.0.0 for LAN+Tailscale; set to your
# Tailscale IP (100.x.y.z) to keep it off the rest of the LAN.
HEARTH_BIND=0.0.0.0
HEARTH_PORT=8787
HEARTH_HOUSE_NAME=VAULT
HEARTH_OWNER=Ruben
# Optional shared secret for machine/agent callers (header X-Hearth-Token only).
# Browser users must log in. If unset, only login counts. Do not put this in a URL.
# HEARTH_TOKEN=

# --- Login (house pattern: FastAPI + bcrypt + X-Auth-Token + HttpOnly refresh cookie) ---
# Required to issue JWTs. Generate a long random string. Never commit the real value.
# APP_SECRET_KEY=
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=14
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# First superuser is created on boot only if the users table is empty.
# HEARTH_ADMIN_EMAIL=
# HEARTH_ADMIN_PASSWORD=
# SQLite file (persistent volume). No Postgres required.
# HEARTH_AUTH_DB=/app/data/hearth-auth.db
# House memory (same ./data volume). Conversations + explicit preferences on;
# house-event logging off until you opt in. Embeddings use OPENAI_API_KEY when set
# (redacted text leaves the NAS). Keyword/FTS still works with no key.
# HEARTH_MEMORY_DB=/app/data/hearth-memory.db
# HEARTH_MEMORY_ENABLED=true
# HEARTH_MEMORY_STORE_CONVERSATIONS=true
# HEARTH_MEMORY_STORE_HOUSE_EVENTS=false
# HEARTH_MEMORY_HOUSE_EVENT_SAMPLE=1
# HEARTH_MEMORY_EMBEDDINGS=true
# HEARTH_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# HEARTH_MEMORY_INJECT=true
# HEARTH_MEMORY_RETENTION_DAYS=90
# HEARTH_MEMORY_HOUSE_EVENT_RETENTION_DAYS=30
# HEARTH_MEMORY_PREFERENCE_RETENTION_DAYS=0
# HEARTH_MEMORY_SUMMARIZE_AFTER=16
# HEARTH_MEMORY_RETRIEVE_K=6
# HEARTH_MEMORY_SESSION_IDLE_MINUTES=240
# HEARTH_MEMORY_PRUNE_INTERVAL_MINUTES=60
# HEARTH_MEMORY_MAX_TURNS=20000
# HEARTH_MEMORY_MAX_HOUSE_EVENTS=5000

# Path inside the container. Compose bind-mounts ./workspace here.
WORKSPACE_PATH=/app/workspace

# When HA / Plex / Docker are unconfigured, return house-shaped fixtures
# so the command center and agent loop still run.
HEARTH_MOCK_IF_UNCONFIGURED=true

# --- OpenAI (text agent + Realtime voice) ---
# Leave empty to run in fallback: local intent router + mocked tools.
# Live voice is GA WebRTC (ChatGPT-app path), not the disabled beta websocket.
OPENAI_API_KEY=
# Optional Admin API key for organization Costs + Usage monitors in the UI.
# Project/inference keys cannot call /v1/organization/costs or /usage/*.
# Create at https://platform.openai.com/settings/organization/admin-keys
# Keep this on the host .env only — never paste into the browser.
# OPENAI_ADMIN_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=marin
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Home Assistant (device layer: lights, Denon AVR-X3700H, LG webOS TV, Apple TV) ---
# HA runs in host-network mode so mDNS/SSDP discovery reaches the LAN. Hearth
# reaches HA through the Synology host gateway:
HA_URL=http://host.docker.internal:8123
# Long-lived access token from HA Profile → Security. Empty = mocked entities.
HA_TOKEN=
# Entity IDs after pairing (HA names them per device). Defaults match fixtures.
# If live entities differ, set these so ha_media_control / house_media / Infuse resolve correctly.
HA_TV_ENTITY=media_player.lg_webos_tv
HA_AVR_ENTITY=media_player.denon_avr_x3700h
# Apple TV (HA apple_tv / pyatv) — required to launch Infuse deep links.
HA_APPLE_TV_ENTITY=media_player.apple_tv
# Reliability: retry transient HA failures, reconnect stale sockets, then verify
# that state actually changed instead of claiming success from HTTP 200 alone.
HA_REQUEST_RETRIES=3
HA_RETRY_BASE_SECONDS=0.25
HA_VERIFY_TIMEOUT_SECONDS=6
HA_VERIFY_POLL_INTERVAL=0.4
HA_ENTITY_CACHE_SECONDS=45
# Denon is the switching/audio hub. Receiver activities use these input names.
HEARTH_RECEIVER_CENTRIC=true
HA_AVR_APPLE_TV_SOURCE=Media Player
HA_AVR_TV_SOURCE=TV Audio
HA_MEDIA_SETTLE_SECONDS=0.5
# Prefer Infuse over the Plex tvOS app for Apple TV playback (infuse|plex).
HEARTH_APPLE_TV_PLAYER=infuse
# INFUSE_APP_ID=com.firecore.infuse

# --- Plex (existing stack on the NAS, not this compose file) ---
# host.docker.internal is the Synology host from the container.
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=
# Optional default client when “play X on the TV” is ambiguous on the Plex-client path.
# Examples: Apple TV, LG, Living Room
# PLEX_DEFAULT_PLAYER=
# When confirm/play finds no online clients, re-poll /clients this long (seconds).
# PLEX_CLIENT_WAIT_SECONDS=12
# PLEX_CLIENT_POLL_INTERVAL=1.5

# --- *arr / Overseerr (existing stack on the NAS — grab/request, not Plex playback) ---
RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=
SONARR_URL=http://host.docker.internal:8989
SONARR_API_KEY=
OVERSEERR_URL=http://host.docker.internal:5055
OVERSEERR_API_KEY=
# Failed/stalled grabs: blocklist + alternate *arr release (not Overseerr re-POST).
# HEARTH_DOWNLOAD_MAX_RETRIES=3
# Zero-progress "downloading" treated as stalled after this many seconds:
# HEARTH_DOWNLOAD_STALL_IDLE_SECONDS=1200

# --- Telegram drop-group inbox (movies / series / TV → *arr / Overseerr) ---
# Off unless TELEGRAM_BOT_TOKEN + at least one TELEGRAM_CHAT_IDS entry are set.
# Create a bot with @BotFather, add it to the house group, disable Group Privacy
# (BotFather → /setprivacy → Disable) so it sees group messages, then paste:
# TELEGRAM_BOT_TOKEN=
# Comma-separated allowlisted group/chat ids (negative for groups/supergroups):
# TELEGRAM_CHAT_IDS=
# Optional: only these Telegram user ids may request (empty = any group member):
# TELEGRAM_USER_IDS=
# Long-polling is the default (no public webhook; Tailscale Funnel stays OFF):
# TELEGRAM_POLL=true
# Optional localhost-only webhook (not default). Handler rejects non-loopback clients:
# TELEGRAM_WEBHOOK_LOCAL=false
# TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# TELEGRAM_RATE_LIMIT_PER_MINUTE=6
# TELEGRAM_DEDUP_WINDOW_SECONDS=120
# TELEGRAM_MAX_TITLE_LENGTH=200
# TELEGRAM_PROGRESS_INTERVAL_SECONDS=45
# Prefer Overseerr when its key is set (feeds *arr); otherwise Radarr/Sonarr direct:
# TELEGRAM_PREFER_OVERSEERR=true

# --- Weather (Open-Meteo — no API key) ---
# Defaults near Ghent / VAULT. Used by get_weather + the weather widget.
# HEARTH_WEATHER_LAT=51.05
# HEARTH_WEATHER_LON=3.72
# HEARTH_WEATHER_PLACE=Home
# HEARTH_WEATHER_MOCK=false

# --- Live web search (house tool: web_search) ---
# Default live backend reuses OPENAI_API_KEY (Responses API hosted web_search).
# Optional Brave key is faster structured results and skips the extra model hop.
# Keys stay on the NAS — never sent to the browser. Empty keys + mock-if-unconfigured
# return fixtures. With mock off and no keys, DuckDuckGo HTML lite is the last resort
# (a real API key is more reliable).
# BRAVE_SEARCH_API_KEY=
# HEARTH_WEB_SEARCH_MOCK=false

# --- Glass overlay smart auto-hide ---
# Fresh window: panel always stays after an update. Idle: soft-hide when talk goes quiet.
# Unrelated conversation soft-hides sooner (client grace ~0.9s). Panels reappear when
# talk / tools match on-screen topics again. Secrets never go to the browser.
# HEARTH_OVERLAY_FRESH_SECONDS=12
# HEARTH_OVERLAY_IDLE_SECONDS=55

# --- Chief of Staff (repo/PR, Gridways, Discord, calendar, anything Hearth cannot do) ---
# POST JSON to this URL. Auth header if key is set: Authorization: Bearer <HEARTH_COS_WEBHOOK_KEY>
# Leave empty — Hearth will say it is not configured. Do not invent a URL.
HEARTH_COS_WEBHOOK=
HEARTH_COS_WEBHOOK_KEY=
# HEARTH_COS_REPO=RubenVroman/Hearth

# --- Docker inspect (read-only socket is mounted by compose) ---
DOCKER_SOCKET=/var/run/docker.sock

# --- House delivery address (Thuisbezorgd). Never invent a street in code. ---
# Required for restaurant browse + order placement. Host .env only.
# HEARTH_DELIVERY_STREET=
# HEARTH_DELIVERY_POSTCODE=
# HEARTH_DELIVERY_CITY=
# HEARTH_DELIVERY_COUNTRY=NL

# --- Thuisbezorgd / Just Eat Takeaway NL ---
# No public self-serve consumer ordering API for house agents. Partner JE-API-KEY
# is required for live paid submit. Empty key → fixtures (browse/cart/confirm still work).
# Credentials and session tokens stay on the server — never send them to the browser.
# THUISBEZORGD_API_BASE=https://nl.api.just-eat.io
# THUISBEZORGD_TENANT=nl
# THUISBEZORGD_API_KEY=
# Optional consumer account (server-side only; never logged):
# THUISBEZORGD_EMAIL=
# THUISBEZORGD_PASSWORD=
# Or a pre-approved consumer session JWT (stored also under data/thuisbezorgd-session.json):
# THUISBEZORGD_SESSION_TOKEN=
